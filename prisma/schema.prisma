generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Job {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  organization String
  location     String
  deadline     DateTime
  description  String   @db.Text
  applyLink    String
  createdAt    DateTime @default(now())
}

model Scholarship {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  country     String
  deadline    DateTime
  description String   @db.Text
  createdAt   DateTime @default(now())
}

model Article {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String   @db.Text
  metaTitle       String
  metaDescription String
  createdAt       DateTime @default(now())
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
}

model AiDraft {
  id              String    @id @default(cuid())
  type            String
  status          String    @default("pending_review")
  sourceUrl       String?
  sourceName      String?
  title           String
  organization    String?
  location        String?
  country         String?
  deadline        DateTime?
  description     String    @db.Text
  applyLink       String?
  content         String?   @db.Text
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
